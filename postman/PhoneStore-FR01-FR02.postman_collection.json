{
  "info": {
    "name": "PhoneStore — FR-01 FR-02 — Local Auth Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local test accounts only. Start the .NET API first. Run 00–17 in order with the cookie jar enabled. Request 01 generates a new email/password each time. Scripts store JWT and CSRF in collection variables; do not use an environment overriding these names. No manually entered Cookie header is required. This file contains no real credentials."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5122",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "old_access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "csrf_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 — Health",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Expected HTTP 200. Run requests in numbered order."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "01 — FR-01 Register new customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        },
        "description": "Expected HTTP 201. Run requests in numbered order.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"fullName\": \"Đỗ Công Trí - API Test\",\n  \"phone\": \"0912345678\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.variables.replaceIn('{{$guid}}');",
              "pm.collectionVariables.set('email', 'tri.' + id + '@example.com');",
              "pm.collectionVariables.set('password', 'Demo@' + id + '1');",
              "['access_token', 'old_access_token', 'csrf_token', 'user_id'].forEach(key => pm.collectionVariables.set(key, ''));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Auth response is not cached', function () { pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); });",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  const data = pm.response.json().data;",
              "  pm.test('Access token is present; refresh token is not in JSON', function () {",
              "    pm.expect(data.accessToken).to.be.a('string').and.not.empty;",
              "    pm.expect(data).not.to.have.property('refreshToken');",
              "    pm.expect(data).not.to.have.property('passwordHash');",
              "    pm.expect(data.role).to.eql('CUSTOMER');",
              "  });",
              "  pm.collectionVariables.set('access_token', data.accessToken);",
              "  pm.collectionVariables.set('user_id', String(data.userId));",
              "  const cookies = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie');",
              "  const csrf = cookies.find(h => h.value.startsWith('phonestore_csrf='));",
              "  const refresh = cookies.find(h => h.value.startsWith('phonestore_rt='));",
              "  pm.test('Refresh cookie is HttpOnly', function () {",
              "    pm.expect(refresh, 'phonestore_rt Set-Cookie').to.exist;",
              "    pm.expect(refresh.value.toLowerCase()).to.include('httponly');",
              "  });",
              "  pm.test('CSRF cookie is present', function () { pm.expect(csrf).to.exist; });",
              "  if (csrf) pm.collectionVariables.set('csrf_token', decodeURIComponent(csrf.value.split(';')[0].split('=')[1]));",
              "}"
            ]
          }
        }
      ]
    },
