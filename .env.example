# ==============================================================================
# PHONESTORE API — LOCAL DEVELOPMENT CONFIG & TEST ACCOUNTS
# ==============================================================================
# File này chứa các tài khoản test mẫu có sẵn trong database (đã seed)
# và các thông số kết nối chạy local.

# ------------------------------------------------------------------------------
# 1. DANH SÁCH TÀI KHOẢN MẪU (PRE-SEEDED ACCOUNTS)
# ------------------------------------------------------------------------------

# [ADMIN] — Quản trị viên (Toàn quyền hệ thống)
TEST_ADMIN_EMAIL=admin@phonestore.vn
TEST_ADMIN_PASSWORD=Admin@123
TEST_ADMIN_ROLE=ADMIN
TEST_ADMIN_NAME="Quản Trị Hệ Thống"

# [STAFF] — Nhân viên cửa hàng (Quản lý kho, quản lý danh mục, xử lý đơn hàng)
TEST_STAFF_EMAIL=staff@phonestore.vn
TEST_STAFF_PASSWORD=Staff@123
TEST_STAFF_ROLE=STAFF
TEST_STAFF_NAME="Trần Nhân Viên"

# [CUSTOMER] — Khách hàng mua sắm (Xem hàng, giỏ hàng, đặt hàng COD, xem đơn)
TEST_CUSTOMER_EMAIL=customer@phonestore.vn
TEST_CUSTOMER_PASSWORD=Customer@123
TEST_CUSTOMER_ROLE=CUSTOMER
TEST_CUSTOMER_NAME="Nguyễn Văn Khách"

# [DEMO] — Khách hàng demo dự phòng
TEST_DEMO_EMAIL=demo@phonestore.vn
TEST_DEMO_PASSWORD=Demo@123
TEST_DEMO_ROLE=CUSTOMER
TEST_DEMO_NAME="Tài Khoản Demo"

# ------------------------------------------------------------------------------
# 2. ĐƯỜNG DẪN TRUY CẬP HỆ THỐNG
# ------------------------------------------------------------------------------
API_BASE_URL=http://localhost:5122
SWAGGER_UI_URL=http://localhost:5122
HEALTH_CHECK_URL=http://localhost:5122/health

# ------------------------------------------------------------------------------
# 3. KẾT NỐI DATABASE (POSTGRESQL DOCKER)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=phonestore_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_CONNECTION_STRING="Host=localhost;Port=5433;Database=phonestore_db;Username=postgres;Password=postgres"

# Danh sách Schema: identity, catalog, cart, ordering, inventory

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH JWT AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_ISSUER=PhoneStore
JWT_AUDIENCE=PhoneStoreClient
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
