{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=phonestore_db;Username=postgres;Password=postgres"
  },
  "Authentication": {
    "Issuer": "PhoneStore",
    "Audience": "PhoneStoreClient",
    "SigningKey": "PhoneStore_Super_Secret_Development_Key_2026_At_Least_64_Characters_Long_For_HmacSha256",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "AllowDevelopmentSigningKey": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5122",
      "http://localhost:8080",
      "http://localhost:5173"
    ]
  },
  "Database": {
    "AutoMigrate": true,
    "AutoSeed": true
  },
  "Swagger": {
    "Enabled": true
  }
}
