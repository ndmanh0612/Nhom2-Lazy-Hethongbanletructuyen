{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Authentication": {
    "Secret": "DevelopmentOnlySuperSecretKeyMustBe32BytesLong!",
    "Issuer": "PhoneStore.Identity",
    "Audience": "PhoneStore.Clients",
    "AccessTokenMinutes": 120,
    "RefreshTokenDays": 7,
    "AllowDevelopmentSigningKey": true
  },
  "MinioStorage": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "admin",
    "SecretKey": "password123",
    "BucketName": "phonestore-images",
    "PublicBaseUrl": "http://localhost:9000"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5122",
      "http://localhost:8080",
      "http://localhost:5173"
    ]
  },
  "Database": {
    "AutoMigrate": true,
    "AutoSeed": true
  },
  "Swagger": {
    "Enabled": true
  }
}
