{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=phonestore_db;Username=postgres;Password=postgres"
  },
  "Authentication": {
    "Issuer": "PhoneStore",
    "Audience": "PhoneStoreClient",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7,
    "AllowDevelopmentSigningKey": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "AutoMigrate": true,
    "AutoSeed": true
  },
  "Swagger": {
    "Enabled": true
  }
}
