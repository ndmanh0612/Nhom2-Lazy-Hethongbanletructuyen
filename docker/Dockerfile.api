# ==============================================================================
# PhoneStore API — Production image
# Multi-stage: restore → publish → runtime (chỉ chứa output + runtime .NET)
# ==============================================================================

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Restore trước để tận dụng cache layer của Docker khi chỉ code thay đổi.
COPY Directory.Build.props PhoneStore.slnx ./
COPY src/ src/
COPY tests/ tests/

RUN dotnet restore src/Host/PhoneStore.Api/PhoneStore.Api.csproj \
 && dotnet publish src/Host/PhoneStore.Api/PhoneStore.Api.csproj \
    -c Release \
    -o /app/publish \
    --no-restore \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

ENV ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_RUNNING_IN_CONTAINER=true \
    ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_gcServer=1

COPY --from=build /app/publish ./

EXPOSE 8080

# Health check mở TCP tới cổng 8080 — image aspnet không có curl/wget.
HEALTHCHECK --interval=20s --timeout=5s --start-period=40s --retries=5 \
    CMD ["bash", "-c", "exec 3<>/dev/tcp/localhost/8080 && echo ok"]

ENTRYPOINT ["dotnet", "PhoneStore.Api.dll"]
