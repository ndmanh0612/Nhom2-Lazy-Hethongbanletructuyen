# ==============================================================================
# PhoneStore — cấu hình cho docker compose production
#
# Sao chép file này thành `docker/env.prod` rồi điền giá trị thật,
# sau đó chạy:
#   docker compose -f docker/docker-compose.prod.yml --env-file docker/env.prod up -d --build
#
# File `docker/env.prod` đã được .gitignore, KHÔNG push lên GitHub.
# ==============================================================================

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi_mat_khau_manh_cho_moi truong
POSTGRES_DB=phonestore_db

# ---- JWT ----
# Bắt buộc >= 32 ký tự. Sinh bằng:
#   dotnet user-jwts create --claim sub=1 --length 64
# hoặc dùng chuỗi ngẫu nhiên dài.
PHONESTORE_SIGNING_KEY=doi_chuoi_ky_jwt_toi_thieu_32_ky_tu_tai_day
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# ---- Reverse proxy ----
WEB_PORT=80
PUBLIC_ORIGIN=http://localhost

# ---- Cloudflare Tunnel (tuỳ chọn, xem docs/DEPLOY.md mục 10) ----
# Token lấy ở Cloudflare Zero Trust → Networks → Tunnels → (tunnel) → Install connector.
# Khi dùng tunnel: để NGINX_CONF=nginx.conf (TLS do Cloudflare lo) và PUBLIC_ORIGIN=https://<domain>.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- MinIO (lưu ảnh sản phẩm upload) ----
# Tài khoản quản trị MinIO, API dùng luôn làm access/secret key. Mật khẩu >= 8 ký tự, nên ngẫu nhiên dài.
MINIO_ROOT_USER=phonestore
MINIO_ROOT_PASSWORD=doi_mat_khau_minio_ngau_nhien_dai
