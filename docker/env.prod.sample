# ==============================================================================
# PhoneStore — cấu hình cho docker compose production
#
# Sao chép file này thành `docker/env.prod` rồi điền giá trị thật,
# sau đó chạy:
#   docker compose -f docker/docker-compose.prod.yml --env-file docker/env.prod up -d --build
#
# File `docker/env.prod` đã được .gitignore, KHÔNG push lên GitHub.
# ==============================================================================

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi_mat_khau_manh_cho_moi truong
POSTGRES_DB=phonestore_db

# ---- JWT ----
# Bắt buộc >= 32 ký tự. Sinh bằng:
#   dotnet user-jwts create --claim sub=1 --length 64
# hoặc dùng chuỗi ngẫu nhiên dài.
PHONESTORE_SIGNING_KEY=doi_chuoi_ky_jwt_toi_thieu_32_ky_tu_tai_day
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# ---- Reverse proxy ----
WEB_PORT=80
PUBLIC_ORIGIN=http://localhost
